# Django Configuration
DJANGO_SECRET_KEY=django-insecure-replace-this-key-for-production-environment-seed-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration (Optional - in-app simulated delivery is active by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@institution.edu

# SMS/WhatsApp Gateway Configuration (Optional - simulated delivery mode by default)
SMS_PROVIDER=simulated
SMS_API_KEY=
WHATSAPP_PROVIDER=simulated
WHATSAPP_API_KEY=

# Attendance Policy Defaults
DEFAULT_ATTENDANCE_THRESHOLD=75.0
DEFAULT_WARNING_THRESHOLD=80.0
DEFAULT_CONSECUTIVE_ABSENCE_ALERT=3
